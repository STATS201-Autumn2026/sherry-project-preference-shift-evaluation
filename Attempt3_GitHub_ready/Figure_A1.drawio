<mxfile host="app.diagrams.net"><diagram name="Figure A1"><mxGraphModel page="1" pageWidth="1000" pageHeight="820"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Consumer Behavior and LLM Recommendation Failure: Research Workflow" style="text;html=1;align=center;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="5" width="960" height="34" /></mxCell><mxCell id="q" value="&lt;b&gt;Research Question&lt;/b&gt;&lt;br&gt;&lt;br&gt;Can behavioral features improve user-level failure prediction beyond history features?" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#e7eff5;strokeColor=#aab9c3;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="48" width="800" height="84" /></mxCell><mxCell id="d" value="&lt;b&gt;Data and Outcome&lt;/b&gt;&lt;br&gt;&lt;br&gt;AgentRecBench Amazon Long-term | 1,420 measurement records; 73 valid prediction records&lt;br&gt;Y = Failure@5 (1 if held-out target rank &gt; 5; otherwise 0)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f2f3f4;strokeColor=#aab9c3;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="151" width="800" height="91" /></mxCell><mxCell id="x0" value="&lt;b&gt;Conventional Features (X₀)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Log history length&lt;br&gt;Category entropy" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#e7eff5;strokeColor=#aab9c3;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="270" width="300" height="108" /></mxCell><mxCell id="x1" value="&lt;b&gt;Dynamic Behavioral Features (X)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Excess TVD (500 permutations)&lt;br&gt;Excess repetition; exploration rate" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#e8f0eb;strokeColor=#aab9c3;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="350" y="270" width="300" height="108" /></mxCell><mxCell id="ass" value="&lt;b&gt;Measurement Assumptions&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pre-target history only&lt;br&gt;Failure@5 ≠ consumer dissatisfaction" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f2f3f4;strokeColor=#aab9c3;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="675" y="270" width="300" height="108" /></mxCell><mxCell id="model" value="&lt;b&gt;Primary Method and Comparison&lt;/b&gt;&lt;br&gt;&lt;br&gt;Logistic regression and random forest | M0–M4 feature comparisons&lt;br&gt;Compare incremental predictive value against conventional features and naive baseline" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#e7eff5;strokeColor=#aab9c3;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="407" width="800" height="90" /></mxCell><mxCell id="eval" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;&lt;br&gt;10 repeated five-fold CV | Log loss and ROC-AUC&lt;br&gt;Fixed budget: 15 of 73 users; compare with 10,000 random allocations" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#e7eff5;strokeColor=#aab9c3;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="525" width="800" height="88" /></mxCell><mxCell id="evidence" value="&lt;b&gt;Initial Evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;No consistent predictive improvement&lt;br&gt;RF M3 captures 7 failures vs. random expectation 5.75&lt;br&gt;Result lies within central 95% random range" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#e8f0eb;strokeColor=#aab9c3;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="642" width="460" height="143" /></mxCell><mxCell id="rev" value="&lt;b&gt;Next Revision&lt;/b&gt;&lt;br&gt;&lt;br&gt;Expand valid recommendation outcomes&lt;br&gt;Check measurement and model stability&lt;br&gt;Reassess decision value before deployment" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#e8f0eb;strokeColor=#aab9c3;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="515" y="642" width="460" height="143" /></mxCell><mxCell id="q_d" edge="1" parent="1" source="q" target="d" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d_x0" edge="1" parent="1" source="d" target="x0" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d_x1" edge="1" parent="1" source="d" target="x1" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d_ass" edge="1" parent="1" source="d" target="ass" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="x0_model" edge="1" parent="1" source="x0" target="model" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="x1_model" edge="1" parent="1" source="x1" target="model" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ass_model" edge="1" parent="1" source="ass" target="model" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="model_eval" edge="1" parent="1" source="model" target="eval" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="eval_evidence" edge="1" parent="1" source="eval" target="evidence" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="eval_rev" edge="1" parent="1" source="eval" target="rev" style="endArrow=block;endFill=1;strokeColor=#81878b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>